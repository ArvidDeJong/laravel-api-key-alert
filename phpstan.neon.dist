includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    ignoreErrors:
        # Larastan cannot resolve views registered under a package namespace. Both mails are
        # rendered in tests/Feature/AlertTest.php, which fails when a view is missing.
        -
            identifier: argument.type
            message: '#view-string\|null, string given#'
            path: src/Mail
    paths:
        - src
